<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <ScrollView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:maxHeight="500dp">

        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/overlay_card_bg"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New task"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TITLE" android:textColor="#66FFFFFF" android:textSize="9sp"
                android:letterSpacing="0.05" android:layout_marginBottom="3dp" />
            <EditText
                android:id="@+id/input_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:padding="9dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#44FFFFFF"
                android:textSize="13sp"
                android:hint="What do you need to do?"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PHASE" android:textColor="#66FFFFFF" android:textSize="9sp"
                android:letterSpacing="0.05" android:layout_marginBottom="3dp" />
            <LinearLayout android:id="@+id/chips_phase"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="STATUS" android:textColor="#66FFFFFF" android:textSize="9sp"
                android:letterSpacing="0.05" android:layout_marginBottom="3dp" />
            <LinearLayout android:id="@+id/chips_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LIFE AREA" android:textColor="#66FFFFFF" android:textSize="9sp"
                android:letterSpacing="0.05" android:layout_marginBottom="3dp" />
            <LinearLayout android:id="@+id/chips_life_area"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DEADLINE" android:textColor="#66FFFFFF" android:textSize="9sp"
                android:letterSpacing="0.05" android:layout_marginBottom="3dp" />
            <TextView
                android:id="@+id/input_deadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:padding="9dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="Tap to set"
                android:textColorHint="#44FFFFFF"
                android:layout_marginBottom="10dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="GOAL" android:textColor="#66FFFFFF" android:textSize="9sp"
                android:letterSpacing="0.05" android:layout_marginBottom="3dp" />
            <TextView
                android:id="@+id/input_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:padding="9dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="Tap to select"
                android:textColorHint="#44FFFFFF"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_cancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Cancel"
                    android:textColor="#AAFFFFFF"
                    android:textSize="13sp"
                    android:background="@drawable/pill_muted"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btn_create"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:text="Create"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/pill_blue"
                    android:padding="10dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
